---
/** Section label: a short orange rule + the section name, e.g. "—— SERVICES". */
interface Props {
  label: string;
  as?: 'p' | 'h2';
  id?: string;
  tone?: 'light' | 'dark';
}
const { label, as: Tag = 'p', id, tone = 'light' } = Astro.props;
---

<Tag class:list={['section-label', `section-label--${tone}`]} id={id}>
  <span class="section-label__rule" aria-hidden="true" data-reveal="line"></span>
  <span class="section-label__text">{label}</span>
</Tag>

<style>
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-4);
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--c-ink);
  }
  .section-label__rule {
    display: block;
    width: 3rem;
    height: 1px;
    background: var(--c-accent);
  }
  .section-label--dark {
    color: var(--c-white);
  }
</style>
